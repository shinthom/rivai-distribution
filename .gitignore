# =========================================================================
#  Rivai workspace .gitignore
# =========================================================================

# UE project (~2.7GB) — managed/built locally; not tracked here.
# .uproject 자체와 Source/Config는 추후 정책 정해지면 부분 추적 검토.
/Rivai/

# -------------------------------------------------------------------------
# Distribution: staging artifacts and build outputs (R2 is source of truth)
# -------------------------------------------------------------------------
/Distribution/staging/
/Distribution/builds/
/Distribution/.wrangler/
/Distribution/cache/

# Tauri launcher build outputs
/Distribution/launcher/target/
/Distribution/launcher/node_modules/
/Distribution/launcher/dist/
/Distribution/launcher/src-tauri/target/
/Distribution/launcher/src-tauri/gen/

# -------------------------------------------------------------------------
# Wiki build output (generated, regenerated by `npm run build`)
# -------------------------------------------------------------------------
/Docs/road-to-rivai/site/
/Docs/road-to-rivai/node_modules/

# -------------------------------------------------------------------------
# Obsidian per-user state (keep .obsidian/ structure, ignore user prefs)
# -------------------------------------------------------------------------
**/.obsidian/workspace.json
**/.obsidian/workspaces.json

# -------------------------------------------------------------------------
# Secrets / env — NEVER commit
# -------------------------------------------------------------------------
.env
.env.*
*.env
secrets.json
*.pem
*.key

# -------------------------------------------------------------------------
# OS / Editor / Tooling caches
# -------------------------------------------------------------------------
.DS_Store
*.swp
*.swo
.vscode/
.idea/
.dotnet-home/
**/.omc/
**/.omx/
